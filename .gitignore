# 1. Bỏ qua các file biên dịch của Java
*.class
*.log
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# 2. Bỏ qua thư mục build của Maven (cực kỳ quan trọng)
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# 3. Bỏ qua cấu hình của các IDE (Đáp ứng đúng yêu cầu của giáo viên)
# - IntelliJ IDEA
.idea/
*.iml
*.iws
out/

# - Eclipse
.project
.classpath
.settings/
.metadata/
bin/

# - Visual Studio Code
.vscode/

# 4. Bỏ qua thư mục build từ script run.sh (nếu có sinh ra)
build/

# 5. Bỏ qua các file rác của Hệ điều hành
.DS_Store
Thumbs.db
ehthumbs.db
$RECYCLE.BIN/

# 6. Bỏ qua file chứa biến môi trường (nếu nhóm bạn có dùng để giấu pass database)
.env
.env.local